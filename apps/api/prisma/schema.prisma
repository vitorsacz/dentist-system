generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
}

enum ClinicType {
  OWN
  RENTED
}

// Cor de identidade — consultório (freelancer) ou dentista (clínica) na
// sidebar da Agenda. Nunca é usada como cor de status de agendamento (essas
// duas continuam em elementos visuais separados de propósito — ver vault:
// dentist-system/"Conectar Agenda a Dados Reais de Consultório e
// Dentistas — Plano Técnico").
enum PaletteColorToken {
  BRAND
  SUCCESS
  WARNING
  ERROR
  INFO
}

// Relação financeira do dentista Freelancer com um consultório específico —
// conceito paralelo a ClinicType/dailyRentValue (aquele é pro Clinic de
// tenant Clínica pagando aluguel internamente). Ver vault:
// dentist-system/"Relação Financeira do Freelancer por Consultório — Plano
// Técnico".
enum LocationRelationshipType {
  RENTED_FIXED
  COMMISSION
  PER_SERVICE
}

enum RentPeriodicity {
  DAILY
  WEEKLY
  MONTHLY
}

enum BudgetStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELED
  NO_SHOW
}

enum ToothRecordStatus {
  PLANNED
  DONE
}

enum RecallStatus {
  PENDING
  DONE
  CANCELED
}

enum TenantType {
  CLINIC
  FREELANCER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  nickname       String?            @unique
  passwordHash   String
  name           String
  role           Role?
  colorToken     PaletteColorToken?
  isSuperAdmin   Boolean            @default(false)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  foundingOfOrganization Organization?    @relation("OrganizationFoundingAdmin")
  createdPatients        Patient[]        @relation("PatientCreatedBy")
  createdClinicalRecords ClinicalRecord[] @relation("ClinicalRecordCreatedBy")
  createdBudgets         Budget[]         @relation("BudgetCreatedBy")
  createdAttendances     Attendance[]     @relation("AttendanceCreatedBy")
  refreshSessions        RefreshSession[]

  @@unique([organizationId, email])
}

// Sessão de refresh (login em um navegador/dispositivo). O refresh token é um
// valor aleatório opaco no cookie httpOnly; aqui fica só o hash SHA-256. Cada
// POST /auth/refresh revoga a sessão atual e cria a próxima na mesma família
// (familyId = um login); reusar uma sessão já revogada revoga a família
// inteira (sinal de token roubado). Sem organizationId de propósito: a sessão
// pertence ao usuário (que já está numa organização só) e é consultada antes
// de existir contexto de tenant — ver refresh-sessions.service.ts.
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Organization {
  id                  String             @id @default(cuid())
  name                String
  type                TenantType         @default(CLINIC)
  status              OrganizationStatus @default(ACTIVE)
  foundingAdminUserId String?            @unique
  foundingAdmin       User?              @relation("OrganizationFoundingAdmin", fields: [foundingAdminUserId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  users                User[]                 @relation("OrganizationUsers")
  clinics              Clinic[]
  clinicFinancialTerms ClinicFinancialTerms[]
  patients             Patient[]
  anamneses            Anamnesis[]
  clinicalRecords      ClinicalRecord[]
  toothRecords         ToothRecord[]
  procedures           ProcedureCatalog[]
  budgets              Budget[]
  budgetItems          BudgetItem[]
  appointments         Appointment[]
  attendances          Attendance[]
  materials            Material[]
  materialBatches      MaterialBatch[]
  materialUsages       MaterialUsage[]
  recalls              Recall[]
}

model Clinic {
  id             String             @id @default(cuid())
  name           String
  type           ClinicType
  dailyRentValue Decimal?           @db.Decimal(10, 2)
  colorToken     PaletteColorToken?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  attendances    Attendance[]
  financialTerms ClinicFinancialTerms?

  @@index([organizationId])
}

// Relação financeira do freelancer com este consultório (só existe pra
// tenant tipo FREELANCER — regra de negócio aplicada no serviço, não é um
// campo aqui; ver ClinicFinancialTermsService). Opcional: um Clinic pode
// não ter linha aqui ainda (cadastro do consultório não bloqueia por isso).
model ClinicFinancialTerms {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  relationshipType LocationRelationshipType

  // RENTED_FIXED
  rentValue       Decimal?         @db.Decimal(10, 2)
  rentPeriodicity RentPeriodicity?

  // COMMISSION
  commissionPercentage Decimal? @db.Decimal(5, 2)

  // PER_SERVICE (valor fixo por atendimento — rate por procedimento é
  // extensão futura, não implementada neste v1)
  defaultServiceRate Decimal? @db.Decimal(10, 2)

  // Referência livre ao proprietário/comissionado — texto, não entidade.
  ownerLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Patient {
  id        String    @id @default(cuid())
  name      String
  phone     String
  birthDate DateTime?
  address   String?

  createdByUserId String
  createdBy       User     @relation("PatientCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  anamnesis       Anamnesis?
  clinicalRecords ClinicalRecord[]
  toothRecords    ToothRecord[]
  budgets         Budget[]
  appointments    Appointment[]
  attendances     Attendance[]
  recalls         Recall[]

  @@index([organizationId])
}

model Anamnesis {
  id               String   @id @default(cuid())
  patientId        String   @unique
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies        String?
  medications      String?
  healthConditions String?
  dentalHistory    String?
  chiefComplaint   String?
  updatedAt        DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ClinicalRecord {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          DateTime
  procedureNote String
  observations  String?

  createdByUserId String
  createdBy       User     @relation("ClinicalRecordCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([patientId, date])
  @@index([organizationId])
}

model ToothRecord {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber Int
  procedure   String
  status      ToothRecordStatus
  notes       String?
  updatedAt   DateTime          @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
}

model ProcedureCatalog {
  id           String  @id @default(cuid())
  name         String
  defaultValue Decimal @db.Decimal(10, 2)
  active       Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  budgetItems BudgetItem[]
  attendances Attendance[]

  @@index([organizationId])
}

model Budget {
  id        String       @id @default(cuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    BudgetStatus @default(PENDING)

  createdByUserId String
  createdBy       User     @relation("BudgetCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items BudgetItem[]

  @@index([patientId])
  @@index([organizationId])
}

model BudgetItem {
  id          String           @id @default(cuid())
  budgetId    String
  budget      Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  procedureId String
  procedure   ProcedureCatalog @relation(fields: [procedureId], references: [id])
  toothNumber Int?
  value       Decimal          @db.Decimal(10, 2)
  notes       String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic            @relation(fields: [clinicId], references: [id])
  startsAt  DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  attendance Attendance?

  @@index([clinicId, startsAt])
  @@index([organizationId])
}

model Attendance {
  id                String           @id @default(cuid())
  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId     String?          @unique
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  clinicId          String
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  procedureId       String
  procedure         ProcedureCatalog @relation(fields: [procedureId], references: [id])
  date              DateTime
  grossValue        Decimal          @db.Decimal(10, 2)
  repassePercentage Decimal          @db.Decimal(5, 2)
  materialCost      Decimal          @default(0) @db.Decimal(10, 2)

  createdByUserId String
  createdBy       User     @relation("AttendanceCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  materialUsages MaterialUsage[]

  @@index([clinicId, date])
  @@index([organizationId])
}

model Material {
  id           String   @id @default(cuid())
  name         String
  unit         String
  minimumStock Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  batches MaterialBatch[]
  usages  MaterialUsage[]

  @@index([organizationId])
}

model MaterialBatch {
  id         String    @id @default(cuid())
  materialId String
  material   Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Decimal   @db.Decimal(10, 2)
  expiryDate DateTime?
  receivedAt DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([organizationId])
}

model MaterialUsage {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material   @relation(fields: [materialId], references: [id])
  quantity     Decimal    @db.Decimal(10, 2)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Recall {
  id        String       @id @default(cuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  reason    String?
  status    RecallStatus @default(PENDING)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
}
