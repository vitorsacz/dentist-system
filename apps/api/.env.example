# Dev local (docker-compose): porta 5433, banco dentist_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dentist_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/dentist_dev"

# Banco de testes local (docker-compose). CI define via secret; dev local usa esse padrão.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dentist_test"
JWT_ACCESS_SECRET="change-me"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Quantos proxies ficam na frente da API (Render = 1). Define o IP do cliente
# usado pelo rate limit. Opcional, padrão 1.
TRUST_PROXY_HOPS=1

# Ambiente: dev | hml | prod. Usado em logs e /health. Sem impacto em segurança.
APP_ENV=dev

# Política do cookie de refresh.
# Em dev local (http://localhost, sem HTTPS): lax + false.
# Em hml/prod (Vercel e Render em origens distintas): none + true.
# Regra: COOKIE_SAMESITE=none exige COOKIE_SECURE=true (browsers rejeitam None sem Secure).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# SHA do commit injetado no build (ex.: git rev-parse --short HEAD).
# "unknown" quando não configurado.
COMMIT_SHA=unknown

# usado só pelo prisma/seed.ts para criar os usuários iniciais
# Super Admin não pertence a nenhuma organização — é quem cria clínicas novas pelo painel /platform
SEED_SUPER_ADMIN_EMAIL="super-admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="dev-only-fake-password"
SEED_SUPER_ADMIN_NAME="Super Admin"

# ADMIN é quem cria/gerencia dentistas e recepcionistas depois, pelo painel /admin/users
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="dev-only-fake-password"
SEED_ADMIN_NAME="Admin"

SEED_DENTIST_EMAIL="dentista@example.com"
SEED_DENTIST_PASSWORD="dev-only-fake-password"
SEED_DENTIST_NAME="Dra. Exemplo"
